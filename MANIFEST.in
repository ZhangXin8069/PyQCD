# Files shipped inside the sdist. Metadata lives in pyproject.toml; the build
# mechanics (native staging, optional Cython extension) live in setup.py.

include LICENSE
include README.md
include README.zh-CN.md
include pyproject.toml
include setup.py
include MANIFEST.in

# Scripts setup.py invokes to compile the native C/CUDA backends.
include build-kupl.sh
include build-nv.sh
include env.sh
include install.sh

# Native backend sources, headers and their Makefile drivers. The build dirs
# under cpp/ hold compiled artefacts and are pruned below.
recursive-include cpp *.h *.cpp *.cu *.sh *.md
prune cpp/kupl/einsum/build
prune cpp/cuda/einsum/build

# Pure-Python package plus the Cython sources of the optional CUDA extension.
recursive-include pyqcd *.py *.pyx *.pxd *.pyi
include pyqcd/py.typed

# Tests, benchmarks and regression baselines stay in the repository only.
prune pyqcd/testing

# Internal contributor notes must not ship to end users.
global-exclude AGENTS.md

# Build artefacts must never reach the sdist.
prune build
global-exclude *.so *.log *.pyc
